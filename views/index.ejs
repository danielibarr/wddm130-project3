<%- include("partials/header") %>

<h1>Welcome to NoticeHub</h1>

<h2>Notices</h2>

<% notices.forEach(function(notice) { %>

    <article>

        <h3><%= notice.title %></h3>

        <p><%= notice.message %></p>

        <small>
            <%= notice.createdAt.toLocaleString() %>
        </small>

    </article>

<% }); %>

<%- include("partials/footer") %>